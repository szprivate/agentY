# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.env

# Official Comfy-Org workflow templates (cloned repo — large)
comfyui_workflow_templates_official_deprecated/

# Chainlit datalayer (cloned by install_agent.ps1)
/chainlit-datalayer/


#Logs and outputs
.logs/
output_images/
output_workflows/
# Agent scratch: scripts it writes (output/scripts) + code-change proposals
# (output/proposals). Media itself lands under ComfyUI's output dir, not here.
/output/
# QA scoring model weights (ArcFace ~0.6 GB, DreamSim ~3 GB). Downloaded on first
# use, deliberately here rather than in a home directory: they are large, they
# belong to this checkout, and C: is not where model weights go.
/models/
/.files
/memory

#other
.claude
.qwen
config/models.json
# Per-machine settings overrides (paths, model pins, private endpoints). Committed
# defaults live in config/settings.default.toml; this file is deep-merged over them.
config/settings.local.json
# Backups written by scripts/migrate_model_tiers.py — machine config, never committed.
config/settings.local.json.*.bak
# OAuth tokens + dynamic client registrations for MCP servers — SECRETS, never commit.
# The MCP server definitions (config/mcp.json) hold no secrets and are tracked.
config/.mcp_tokens/
# Ranking weights fitted to THIS person's review choices (scripts/fit_fitness_weights.py).
# One machine's taste is not a default for anyone else's; the hand-set weights in
# src/utils/fitness.py are what ships. Delete the file to go back to them.
config/fitness_weights.json
.vscode

# The workflow-template corpus + recipe DB are now canonical in agenty_core
# (agenty_core.paths.corpus_root); they must NOT be re-created here, or the
# repos would drift apart again. The tool layer reads them from agenty_core.
comfyui_workflow_templates_custom/
comfyui_workflow_templates_official/
config/workflow_templates.json
config/workflow_recipes.json
config/workflow_recipes_node_knowledge.json
config/workflow_recipes_report.md
config/workflow_recipes_object_info_cache.json
# recipe-reliability transient logs
scripts/recipe_reliability/*.log

scripts/recipe_reliability/brain_assembly_report.json
input/

scripts/recipe_reliability/researcher_finetune_data*/
scripts/recipe_reliability/downloaded_models*.jsonl
scripts/recipe_reliability/sweep_final.log
# Understand-Anything knowledge-graph output
.ua/

# Never the agentY repo's own directory. Project memory lives in ComfyUI's user
# directory, which the pipeline moves per project; a `user/` here only ever means
# something resolved that path wrongly (see agenty_core get_comfyui_dirs).
user/

# `> nul` is a Windows device name. On macOS it is an ordinary file, so a command
# copied across platforms silently drops a junk file in the repo root.
nul

# The agent host's session token. The ComfyUI panel reads it from here to
# authenticate to the host — a real credential, and one that means nothing on any
# other machine.
#
# Glob, not the bare name: a sync tool or a Finder copy leaves ".agenty_token 2"
# beside it, and a stray file holding a live token is the last thing that should
# be able to slip into a commit because the pattern was exact.
.agenty_token*
# When each API key in .env was first seen, so the host can warn about ones that
# have gone unrotated. Holds fingerprints, never the keys themselves.
config/key_ages.json
