# Get your HuggingFace token from https://huggingface.co/ -- Create an account, create an Access Token
# To use Claude (recommended): create an API key at https://platform.claude.com/
# To use ComfyUI API nodes: create a ComfyUI Account / API key under https://platform.comfy.org/profile/api-keys

HF_TOKEN=hf_...
ANTHROPIC_API_KEY=sk-ant-...
COMFYUI_API_KEY=comfyui-...

# Optional — the chat host binds here (the ComfyUI agentY sidebar connects to it).
# AGENTY_UI_HOST=127.0.0.1
# AGENTY_UI_PORT=5000

# Optional — where conversations are stored (default: ./memory/conversations.sqlite)
# AGENTY_CONVERSATION_DB=./memory/conversations.sqlite
