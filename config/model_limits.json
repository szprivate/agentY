  "image_sources": {
    "_about": [
      "How many images a node class puts on its IMAGE output, for counting what",
      "arrives at a limited input. Only these are counted; anything else makes the",
      "count unknown, and an unknown count never reports a violation — a wrong",
      "'too many images' would be worse than the miss it prevents."
    ],
