{
  "comfyui_url": "http://127.0.0.1:8188",
  // Address the ComfyUI sidebar connects to (the agentY chat host / agent
  // server). One URL: host + port combined. Change the port here to move the
  // backend; it applies on the next launch (run_agent.ps1 /
  // python -m src.agenty_ui_server).
  "agent_server_url": "http://127.0.0.1:5000",
  "system_prompts": {
    "orchestrator": "system_prompt.orchestrator.md",
    "query_templates": "system_prompt.query_templates.md",
    "assemble_workflow": "system_prompt.assemble_workflow.md",
    "detect_user_intent": "system_prompt.detect_user_intent.md",
    "planner": "system_prompt.planner.md",
    "error_checker": "system_prompt.error_checker.md",
    "info": "system_prompt.info.md",
    "learnings": "system_prompt.learnings.md",
    "qa_checker": "system_prompt.qaChecker.md",
    "vision_agent": "system_prompt.vision_agent.md",
    "story": "system_prompt.story.md",
    "search_web": "system_prompt.search_web.md",
    "dop": "system_prompt.dop.md",
    "custom_node_creator": "system_prompt.custom_node_creator.md"
  },
  "comfyui_models_dir": "L:\\software\\comfyui\\Models",
  "comfyui_custom_templates_dir": "./comfyui_workflow_templates_custom/templates/",
  "output_dir": "./output_images/",
  "output_workflows_dir": "./output_workflows/",
  // Fallback only — the live value is read from ComfyUI's --user-directory flag
  // (/system_stats) and shown in the settings UI. This is used when ComfyUI is
  // unreachable.
  "comfyui_user_dir": "\\\\bepic-storage01\\work\\0193_Never_Stop_Dreaming_Spec\\02_build\\comfy\\sebastian.zilius\\user_dir",
  "conversation_db": "./memory/conversations.sqlite",
  // Auto-open every workflow the agent runs onto the ComfyUI canvas so you can
  // inspect it. Off by default: workflows still build and run, but the graph is
  // not loaded unless you ask (the agent offers to). Env override:
  // AGENTY_CANVAS_AUTOLOAD (1/0).
  "autoload_workflows_into_canvas": true,
  "message_history_log": "./.logs/message_history.log",
  "tokens_usage_log": "./.logs/tokens_usage.log",

  "director": {
    // Storyboard director: max Vision-QA attempts per visual step before asking
    // the user whether to keep retrying (env override: DIRECTOR_AUTO_RETRIES).
    "auto_retries": 2,
    // Default for the per-step user-approval gate: true = pause for approval after
    // each step; false / 0 = run fully autonomously. A request in the user's
    // message (e.g. "ask me for approval" or "run autonomously") overrides this
    // per-run. (env override: DIRECTOR_USER_APPROVAL_STEP)
    "user_approval_step": false,
    // Run the DoP (Director of Photography) pass over the finished storyboard
    // before generation: rewrites every start frame + shot with concrete
    // lighting/composition/camera/colour. true = on (default), false / 0 = off.
    // A request in the user's message (e.g. "skip cinematography") overrides this
    // per-run. (env override: DIRECTOR_APPLY_CINEMATOGRAPHY)
    "apply_cinematography": true
  },

  "llm": {
    
    "pipeline": {
      "orchestrator": "dashscope,qwen3.6-flash",
      "query_templates": "dashscope,qwen3.6-flash",
      "assemble_workflow": "dashscope,qwen3.6-plus",
      "custom_node_creator": "dashscope,kimi-k2.7-code",
      "detect_user_intent": "dashscope,qwen3.6-flash",
      "info": "dashscope,qwen-flash",
      "story": "dashscope,qwen3.6-flash",
      "search_web": "dashscope,qwen3.6-flash",
      "dop": "dashscope,qwen3.6-flash",
      "planner": "dashscope,qwen3.6-flash",
      "learnings": "dashscope,deepseek-v4-flash",
      "error_checker": "dashscope,qwen3.6-flash",
      "build_skill": "dashscope,qwen3.6-flash",
      "llm_functions": "dashscope,qwen-flash",
      "executor_vision_model": "dashscope,qwen-flash"
    },

    "ollama": {
      "host": "http://localhost:11434",
      "num_ctx": 32768,
      "max_tokens": 16384,
      "repeat_penalty": 1.1,
      "think": false
    },

    "anthropic": {
      "model": "claude-haiku-4-5",
      "max_tokens": 16384,
      // Extended thinking (reasoning). Off by default; turn on to let Claude
      // reason before answering. Env override: ANTHROPIC_THINK (1/0). The
      // thinking budget is min(4096, max_tokens-1024) tokens.
      "think": false
    },

    // Alibaba Model Studio (Dashscope) — Qwen models via the OpenAI-compatible API.
    // Set any pipeline stage above to "Dashscope,<model>" (e.g. "Dashscope,qwen-plus")
    // and put your key in .env as DASHSCOPE_API_KEY. For mainland China use
    // "https://Dashscope.aliyuncs.com/compatible-mode/v1".
    "dashscope": {
      "base_url": "https://ws-buzgri7bv429rf4a.eu-central-1.maas.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-plus",
      "max_tokens": 8192,
      // Qwen "thinking" (reasoning) mode. Off by default (reasoning_content breaks
      // the multi-turn tool loop). Env override: DASHSCOPE_ENABLE_THINKING (1/0).
      // NOTE: token/context caching is automatic (implicit) for Qwen via the
      // OpenAI-compatible API — no flag needed; cache hits show in the token log.
      "enable_thinking": false
    },

    "history_window": 12
  },

  "memory": {
    // Long-term agent memory (mem0). The vector store is ALWAYS local FAISS on
    // disk (./memory) — only the embedder (and the rarely-used fact-extraction
    // LLM) call out to a provider. Set "enabled": false to turn memory off.
    "enabled": true,
    "store_dir": "memory",

    // Embedder — turns text into vectors for FAISS. "provider" is:
    //   "ollama"  fully local, needs Ollama running (model e.g. nomic-embed-text),
    //   "openai"  any OpenAI-compatible endpoint. Leave base_url blank for real
    //             OpenAI; for DashScope/Qwen set base_url to the compatible-mode
    //             URL and api_key_env to DASHSCOPE_API_KEY (a good model is
    //             text-embedding-v3 with embedding_dims 1024). The key itself is
    //             read from that .env var, never stored here.
    // NOTE: changing the embedder or embedding_dims makes the existing on-disk
    // index incompatible — delete memory/agenty_memory.* so it rebuilds at the
    // new size. Env overrides: MEMORY_EMBEDDER_PROVIDER / MEMORY_EMBED_MODEL /
    // MEMORY_EMBED_DIMS / MEMORY_EMBEDDER_BASE_URL / MEMORY_EMBEDDER_API_KEY_ENV.
    "embedder": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "embedding_dims": 768,
      "base_url": "",
      "api_key_env": "OPENAI_API_KEY"
    },

    // Fact-extraction LLM — only used for "infer" writes (dedup / atomic-fact
    // extraction). The default write path stores text verbatim and never calls
    // it, so this can usually be left as-is. Same provider choices as the
    // embedder; a blank "model" falls back to the llm_functions pipeline model.
    // Env overrides: MEMORY_LLM_PROVIDER / MEMORY_LLM_MODEL /
    // MEMORY_LLM_BASE_URL / MEMORY_LLM_API_KEY_ENV.
    "llm": {
      "provider": "ollama",
      "model": "",
      "base_url": "",
      "api_key_env": "OPENAI_API_KEY"
    }
  }
}
