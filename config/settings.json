{
  "comfyui_url": "http://127.0.0.1:8188",
  "system_prompts": {
    "query_templates": "system_prompt.query_templates.md",
    "assemble_workflow": "system_prompt.assemble_workflow.md",
    "detect_user_intent": "system_prompt.detect_user_intent.md",
    "planner": "system_prompt.planner.md",
    "error_checker": "system_prompt.error_checker.md",
    "info": "system_prompt.info.md",
    "learnings": "system_prompt.learnings.md",
    "qa_checker": "system_prompt.qaChecker.md",
    "vision_agent": "system_prompt.vision_agent.md",
    "story": "system_prompt.story.md",
    "search_web": "system_prompt.search_web.md",
    "dop": "system_prompt.dop.md"
  },
  "comfyui_models_dir": "L:\\software\\comfyui\\Models",
  "comfyui_custom_templates_dir": "./comfyui_workflow_templates_custom/templates/",
  "output_dir": "./output_images/",
  "output_workflows_dir": "./output_workflows/",
  "comfyui_user_dir": "D:\\ai\\ComfyUI\\user\\default",
  "conversation_db": "./memory/conversations.sqlite",
  "message_history_log": "./.logs/message_history.log",
  "tokens_usage_log": "./.logs/tokens_usage.log",

  "director": {
    // Storyboard director: max Vision-QA attempts per visual step before asking
    // the user whether to keep retrying (env override: DIRECTOR_AUTO_RETRIES).
    "auto_retries": 2,
    // Default for the per-step user-approval gate: true = pause for approval after
    // each step; false / 0 = run fully autonomously. A request in the user's
    // message (e.g. "ask me for approval" or "run autonomously") overrides this
    // per-run. (env override: DIRECTOR_USER_APPROVAL_STEP)
    "user_approval_step": false,
    // Run the DoP (Director of Photography) pass over the finished storyboard
    // before generation: rewrites every start frame + shot with concrete
    // lighting/composition/camera/colour. true = on (default), false / 0 = off.
    // A request in the user's message (e.g. "skip cinematography") overrides this
    // per-run. (env override: DIRECTOR_APPLY_CINEMATOGRAPHY)
    "apply_cinematography": true
  },

  "llm": {
    
    "pipeline": {
      "query_templates": "dashscope,qwen3.7-plus",
      "assemble_workflow": "dashscope,qwen3.7-plus",
      "detect_user_intent": "dashscope,qwen3.7-plus",
      "info": "dashscope,qwen3.7-plus",
      "story": "dashscope,qwen3.7-plus",
      "search_web": "dashscope,qwen3.7-plus",
      "dop": "dashscope,qwen3.7-plus",
      "planner": "dashscope,qwen3.7-plus",
      "learnings": "dashscope,qwen3.7-plus",
      "error_checker": "dashscope,qwen3.7-plus",
      "build_skill": "dashscope,qwen3.7-plus",
      "llm_functions": "dashscope,qwen3.7-plus",
      "executor_vision_model": "dashscope,qwen3.7-plus"
    },

    "ollama": {
      "host": "http://localhost:11434",
      "num_ctx": 32768,
      "max_tokens": 16384,
      "repeat_penalty": 1.1,
      "think": true
    },

    "anthropic": {
      "model": "claude-haiku-4-5",
      "max_tokens": 16384
    },

    // Alibaba Model Studio (Dashscope) — Qwen models via the OpenAI-compatible API.
    // Set any pipeline stage above to "Dashscope,<model>" (e.g. "Dashscope,qwen-plus")
    // and put your key in .env as DASHSCOPE_API_KEY. For mainland China use
    // "https://Dashscope.aliyuncs.com/compatible-mode/v1".
    "dashscope": {
      "base_url": "https://ws-buzgri7bv429rf4a.eu-central-1.maas.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-plus",
      "max_tokens": 8192
    },

    "history_window": 12
  }
}
