# /etc/agenty/agenty.env  (chmod 600, owned by the service account)
# Read by the systemd unit (EnvironmentFile) and, on Windows, copied into the
# NSSM service's environment by deploy/install-service.ps1.
# Only what differs from a desktop install needs to be here. API keys can stay in
# the checkout's .env as usual.

# --- Slack (docs/slack.md) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_ALLOWED_USERS=U01ABCDEF,U02GHIJKL
SLACK_ALLOWED_CHANNELS=C0123ABCD
SLACK_APPROVERS=U01ABCDEF

# --- Server mode (docs/server.md) ---
AGENTY_HEADLESS=1
# Loopback behind a reverse proxy (recommended). 0.0.0.0 only on a network you trust.
AGENTY_BIND_HOST=127.0.0.1
AGENTY_USER_TOKENS=1

# --- Where things are ---
AGENTY_COMFYUI_URL=http://127.0.0.1:8188
AGENTY_COMFYUI_MODELS_DIR=/mnt/shared/comfyui/models
AGENTY_OUTPUT_DIR=/mnt/shared/comfyui/output
AGENTY_OUTPUT_WORKFLOWS_DIR=/mnt/shared/agenty/workflows

# --- Farm (docs/deadline.md), only if you send renders to Deadline ---
# DEADLINE_PATH=
# DEADLINE_OUTPUT_DIR=\bepic-storage01\farm\output\agenty
